# Puerto de la API
PORT=3000

# Cadena de conexión a PostgreSQL (formato: postgres://usuario:password@host:puerto/base)
DATABASE_URL=postgres://pausas_admin:pausas_admin@localhost:5432/pausas_activas

# Secreto para firmar los tokens (genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia_esta_clave_por_una_segura
JWT_EXPIRES_IN=1h

# Costo del hash de contraseñas
BCRYPT_ROUNDS=12

# Origen permitido del frontend (comma-separated o *)
CORS_ORIGIN=*

# Entorno (development habilita synchronize y logs de TypeORM)
NODE_ENV=development

# Repositorio multimedia (EP05)
MEDIA_UPLOAD_DIR=./uploads
MEDIA_MAX_FILE_SIZE_MB=200
MEDIA_ALLOWED_MIME=video/mp4,video/webm,video/ogg,video/quicktime

# Zona horaria para agrupación de datos y rachas
APP_TIMEZONE=America/Bogota

# Motor de programación (EP12). Desactivar en instancias secundarias
SCHEDULER_ENABLED=true

# Exigir consentimiento informado antes de registrar telemetría (EP16)
CONSENT_REQUIRED=false

# URL del frontend (se usa en los enlaces de los correos)
FRONTEND_URL=http://localhost:4200

# Recuperación de contraseña: vigencia del enlace en minutos
PASSWORD_RESET_TTL_MINUTES=30

# Correo saliente (SMTP). Si SMTP_HOST queda vacío, el enlace de recuperación se imprime en la consola del backend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ACTIVATE Pausas Saludables <no-reply@pausas.com>

# Notificaciones Web Push. Genera el par de claves con: npx web-push generate-vapid-keys
# Sin claves, las notificaciones push quedan desactivadas (los avisos dentro de la app siguen funcionando)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pausas.com